<%= form_with model: [:admin, skill], class: "admin-form" do |f| %>
  <% if skill.errors.any? %>
    <div class="admin-error-summary">
      <p><%= pluralize(skill.errors.count, "błąd") %> uniemożliwia zapisanie umiejętności:</p>
      <ul>
        <% skill.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="admin-field">
    <%= f.label :category, "Kategoria" %>
    <%= f.text_field :category, required: true %>
    <span class="hint">np. „Backend i dane” — istniejące kategorie grupują umiejętności na stronie.</span>
  </div>

  <div class="admin-field">
    <%= f.label :name, "Nazwa" %>
    <%= f.text_field :name, required: true %>
  </div>

  <div class="admin-field">
    <%= f.label :position, "Pozycja (kolejność w kategorii)" %>
    <%= f.number_field :position %>
  </div>

  <div class="admin-form-actions">
    <%= f.submit "Zapisz", class: "btn btn-primary" %>
    <%= link_to "Anuluj", admin_skills_path, class: "btn btn-ghost" %>
  </div>
<% end %>
