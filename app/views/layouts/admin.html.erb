<!DOCTYPE html>
<html lang="pl">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Admin — Portfolio</title>
    <meta name="robots" content="noindex, nofollow">
    <link rel="icon" href="data:,">
    <%= stylesheet_link_tag "admin" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="admin-body">
    <header class="admin-header">
      <%= link_to "Portfolio admin", admin_root_path, class: "admin-brand" %>
      <nav class="admin-nav">
        <%= link_to "Projekty", admin_projects_path %>
        <%= link_to "Umiejętności", admin_skills_path %>
        <%= link_to "Zobacz stronę ↗", root_path, target: "_blank", rel: "noopener" %>
      </nav>
    </header>

    <main class="admin-main">
      <% if notice %>
        <p class="admin-flash admin-flash-notice"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="admin-flash admin-flash-alert"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
